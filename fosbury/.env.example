# ── Project Fosbury · environment config ──────────────────────────────────────
# Copy to .env and fill in real values.

# --- API credentials ---------------------------------------------------------
# EIA open data API key — free registration at https://www.eia.gov/opendata/
EIA_API_KEY=YOUR_EIA_API_KEY_HERE

# PJM Data Miner 2 — public endpoints need no key; subscription endpoints do.
# Leave blank to use only public endpoints.
PJM_API_KEY=

# Discord webhook URL for GRP research alerts (optional).
# Create one at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# --- Behaviour ---------------------------------------------------------------
# Set to "true" to serve fixture JSON instead of hitting live APIs.
# Safe default for CI and first-run smoke tests.
STUB_MODE=true

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Storage -----------------------------------------------------------------
SQLITE_PATH=data/sqlite/fosbury.db
PARQUET_DIR=data/parquet

# --- HTTP retry --------------------------------------------------------------
HTTP_RETRY_MAX=3
HTTP_RETRY_WAIT_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=30.0

# --- Pipeline window ---------------------------------------------------------
# ISO-8601 dates; defaults to "yesterday" when blank
LOOKBACK_DAYS=7
